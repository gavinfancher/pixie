#!ipxe

set server 10.0.0.55

:menu
menu pixie  --  ${net0/mac}
item u2604   Install Ubuntu Server 26.04   ** ERASES THE DISK **
item u2404   Install Ubuntu Server 24.04   ** ERASES THE DISK **
item local   Boot from local disk (default)
choose --default local --timeout 30000 target || goto local
goto ${target}

:u2604
set image ubuntu-26.04
goto install

:u2404
set image ubuntu-24.04
goto install

:install
echo
echo   pixie: booting ${image} from ${server}
echo
kernel http://${server}/images/${image}/vmlinuz initrd=initrd ip=dhcp url=http://${server}/images/${image}/image.iso autoinstall ds=nocloud-net;s=http://${server}/autoinstall/ ---
initrd http://${server}/images/${image}/initrd
boot || goto failed

:local
echo Booting from local disk.
exit 0

:failed
echo
echo   ${image} failed to boot. Was it fetched?  ./scripts/fetch-image.sh ${image}
prompt Press a key to return to the menu.
goto menu
