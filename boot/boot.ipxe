#!ipxe

# Our own address, stated explicitly.
#
# It is tempting to use iPXE's ${next-server} here instead. Don't. Once iPXE
# starts it makes its own DHCP request, UniFi answers that one as well, and
# its reply overwrites next-server with the gateway (10.0.0.1). The machine
# then asks the router for the installer and gets "Permission denied".
set server 10.0.0.55

:menu
menu pixie  --  ${net0/mac}
item u2604   Install Ubuntu Server 26.04   ** ERASES THE DISK **
item u2404   Install Ubuntu Server 24.04   ** ERASES THE DISK **
item local   Boot from local disk (default)
choose --default local --timeout 30000 target || goto local
goto ${target}

# Each release is a directory under images/. Adding one is a new label here
# plus a new item above.
:u2604
set image ubuntu-26.04
goto install

:u2404
set image ubuntu-24.04
goto install

:install
echo
echo   pixie: booting ${image} from ${server}
echo
# vmlinuz and initrd were extracted out of the ISO. Linux takes over from
# here, and the installer fetches the ISO itself over HTTP -- that is url=.
# autoinstall + ds=nocloud-net point the installer at our answer files.
# The trailing slash on s= is required: cloud-init appends user-data and
# meta-data to it. Without it you silently get the interactive installer.
kernel http://${server}/images/${image}/vmlinuz initrd=initrd ip=dhcp url=http://${server}/images/${image}/image.iso autoinstall ds=nocloud-net;s=http://${server}/autoinstall/ ---
initrd http://${server}/images/${image}/initrd
boot || goto failed

:local
echo Booting from local disk.
exit 0

:failed
echo
echo   ${image} failed to boot. Was it fetched?  ./scripts/fetch-image.sh ${image}
prompt Press a key to return to the menu.
goto menu
