#cloud-config
#
# This file MUST be named exactly "user-data" -- no extension. cloud-init
# appends that literal name to the s= URL in boot.ipxe. Rename it and the
# fetch 404s and you silently get the interactive installer instead.
#
# The "#cloud-config" line above is not a comment either: it is how
# cloud-init identifies the format. Removing it breaks the file.
#
# Hostname is the same for every machine on purpose. Ansible renames them
# afterwards -- a hostname is configuration, and configuration can be
# re-applied, whereas this file only runs once at install time.
autoinstall:
  version: 1

  # Just enough to get a bootable machine that Ansible can reach.
  # Everything else belongs in Ansible, which can be re-run; this file
  # only ever executes once, during installation.

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Whole first disk, LVM. Fine for identical mini PCs. Pin this to a disk
  # serial if a machine ever has more than one drive.
  storage:
    layout:
      name: lvm

  # SSH keys only. No password is set on the account, so this file contains
  # nothing secret and can be served over plain HTTP.
  user-data:
    hostname: ubuntu
    users:
      - name: ubuntu
        groups: [adm, sudo]
        shell: /bin/bash
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        lock_passwd: true
        ssh_authorized_keys:
          - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF1WilHLdRuxd4ZxJi1SKalgBgR7EaAHHaTDWgMxO+UH gavin@gavin-macbook-pro.localdomain

  ssh:
    install-server: true
    allow-pw: false

  shutdown: reboot
