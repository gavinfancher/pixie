#cloud-config

autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  storage:
    layout:
      name: lvm

  user-data:
    hostname: ubuntu
    users:
      - name: ubuntu
        groups: [adm, sudo]
        shell: /bin/bash
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        lock_passwd: true
        ssh_authorized_keys:
          - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF1WilHLdRuxd4ZxJi1SKalgBgR7EaAHHaTDWgMxO+UH gavin@gavin-macbook-pro.localdomain

  ssh:
    install-server: true
    allow-pw: false

  shutdown: reboot